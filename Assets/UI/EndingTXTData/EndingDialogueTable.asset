      condition: 0
      triggerEventId: 
      triggerOptionIndex: 0
    - rawText: "\uB2F9\uC2E0\uC740 (\uC27C\uC5C6\uC774) \uD0DC\uC591\uC744 \uCC2C\uBBF8\uD558\uACE0"
