      displayMode: 0
      condition: 0
      triggerEventId: 
      triggerOptionIndex: 0
    - rawText: "\uD0DC\uC591\uCC98\uB7FC \uC628\uD654\uD55C \uBBF8\uC18C\uB97C \uB744\uBA70"
      displayMode: 0
      condition: 1
      triggerEventId: 
      triggerOptionIndex: 0
    - rawText: "\uD0DC\uC591\uCC98\uB7FC \uAD73\uC13C \uC8FC\uBA39\uC744 \uC950\uACE0"
      displayMode: 0
      condition: 2
      triggerEventId: 
      triggerOptionIndex: 0
    - rawText: "\uB2F9\uC2E0\uC740 \uD654\uB824\uD55C \uD0DC\uC591\uC758 \uC637\uC744
