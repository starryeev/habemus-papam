      displayMode: 0
      condition: 0
      triggerEventId: 
      triggerOptionIndex: 0
    - rawText: "({\uD50C\uB808\uC774\uC5B4\uC758 \uC774\uB984} {\uB370\uC774\uD130\uC5D0
        \uC800\uC7A5\uB418\uC5B4 \uC788\uB294 \uBA87\uBC88\uC9F8 \uAD50\uC8FC\uC778\uC9C0}\uC138)\uAC00
