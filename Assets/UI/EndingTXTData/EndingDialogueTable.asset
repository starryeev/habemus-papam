      displayMode: 0
      condition: 0
      triggerEventId: 
      triggerOptionIndex: 0
    - rawText: "\uD0DC\uC591\uC744 \uD5A5\uD55C (\uC808\uC2E4\uD55C \uAE30\uB3C4)\uC640"
      displayMode: 0
      condition: 0
      triggerEventId: 
      triggerOptionIndex: 0
    - rawText: "\uAE30\uB3C4 {\uAE30\uB3C4 \uD69F\uC218}\uD68C"
      displayMode: 1
      condition: 0
      triggerEventId: 
      triggerOptionIndex: 0
    - rawText: "(\uBAA8\uB4E0 \uC7A5\uB85C\uB4E4\uC758 \uB9C8\uC74C)\uC744 \uBAA8\uC544"
      displayMode: 0
      condition: 0
      triggerEventId: 
      triggerOptionIndex: 0
    - rawText: "\uC5F0\uC124 {\uC5F0\uC124 \uD69F\uC218}\uD68C"
      displayMode: 1
      condition: 0
      triggerEventId: 
      triggerOptionIndex: 0
    - rawText: "\uC81C {\uB370\uC774\uD130\uC5D0 \uC800\uC7A5\uB418\uC5B4 \uC788\uB294
