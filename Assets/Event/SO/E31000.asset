  eventName: "\uC790\uC5F0\uC8FC\uC758"
  eventDescription: "\"\uCF85!\n\uD55C\uAECF \uB2EC\uC544\uC624\uB978 \uBD84\uC704\uAE30
    \uC18D, \uB204\uAD70\uAC00 \uCC45\uC0C1\uC744 \uC8FC\uBA39\uC73C\uB85C \uCE58\uBA70
    \uACE0\uD568\uC744 \uC9C8\uB800\uB2E4. (\uD6C4\uBCF4 3)\uC600\uB2E4.\n\uC6D0\uCE59\uC8FC\uC758\uC790\uC778
    \uADF8\uB294, \uD0DC\uC591\uC758 \uC5D0\uB108\uC9C0\uB294 \uC790\uC5F0 \uC18D\uC5D0\uC11C\uB9CC
    \uB290\uB084 \uC218 \uC788\uB2E4\uACE0 \uC8FC\uC7A5\uD55C\uB2E4.\n\uBC18\uBA74
    (\uD6C4\uBCF4 2)\uB294, \uD0DC\uC591 \uC5D0\uB108\uC9C0\uB97C \uBD88\uB7EC\uC624\uB294
    '\uD0DC\uC591\uC758 \uCDA4'\uC744 \uCD98\uB2E4\uBA74 \uC2E0\uD559\uC801\uC73C\uB85C
    \uBB38\uC81C\uAC00 \uC5C6\uB2E4\uACE0 \uD55C\uB2E4.\n\uB204\uAD6C\uC758 \uD3B8\uC744
    \uB4E4\uC5B4 \uC904\uAE4C?\""
