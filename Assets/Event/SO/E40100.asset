  eventDescription: "\uCD94\uAE30\uACBD\uB4E4\uC774 \uC639\uAE30\uC885\uAE30 \uC549\uC544
    \uC18C\uB625\uAD6C\uB9AC \uD55C\uB9C8\uB9AC\uB97C \uAD00\uCC30\uD558\uACE0 \uC788\uB2E4.\n\"\uADF8\uB7EC\uACE0
    \uBCF4\uB2C8, \uC774 \uBC8C\uB808\uAC00 \uB625\uC744 \uAD74\uB9AC\uB294 \uBAA8\uC591\uC0C8\uAC00
