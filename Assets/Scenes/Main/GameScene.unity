  m_Script: {fileID: 11500000, guid: 756685d7562b06b4595c5588d8cf021e, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Closeup
  Picture: {fileID: 655566266}
  Name: {fileID: 2034579381}
  Title: {fileID: 1623667531}
  Description: {fileID: 1590158286}
  Passive: {fileID: 183292165}
  HP: {fileID: 1236173248}
  hp: {fileID: 390687811}
  Piety: {fileID: 1561032552}
  piety: {fileID: 1685021589}
  Influence: {fileID: 468088696}
  influence: {fileID: 1402248471}
  DummyNames:
  - player
  - Trump VI
  - Ghandi XVII
  - Bear III
  DummyTitles:
  - "\uAD50\uC8FC\uB294 \uC2EB\uC5B4"
  - "\uAC15\uACBD\uD30C\uC758 \uC218\uC7A5, \uC815\uCE58\uC758 \uC81C\uC655"
  - "\uACBD\uAC74\uD568\uC774 \uB118\uCE58\uB294 \uB0AE\uC740 \uACF3\uC758 \uC218\uD638\uC790"
  - "\uC5D0\uB108\uC9C0\uAC00 \uCDA9\uB9CC\uD55C \uC790\uC5F0\uC758 \uC218\uB3C4\uC790"
  DummyDescriptions:
  - "\uB2F9\uC2E0\uC740 \uC774\uBC88 \uC36C\u3161\uD074\uB77C\uBCA0\uC5D0\uC11C \uAC00\uC7A5
    \uAC01\uAD11\uBC1B\uB294 \uD6C4\uBCF4\uC785\uB2C8\uB2E4. \uBA38\uB9BF\uC18D\uC5D0
    \uC740\uD1F4\uD560 \uC0DD\uAC01\uBC16\uC5D0 \uC5C6\uB2E4\uB294 \uAC83\uB9CC \uBEB4\uBA74
    \uB9D0\uC774\uC8E0. \uC5B4\uB460\uC758 \uACF5\uC791\uC744 \uD1B5\uD574 \uB2E4\uB978
    \uD6C4\uBCF4\uB97C \uACF5\uC791\uC5D0 \uB2F9\uC120\uC2DC\uD0A4\uC138\uC694!"
  - "\uADF8\uB97C \uC815\uCE58\uB825\uC73C\uB85C \uC774\uAE38 \uC0AC\uB78C\uC740
    \uC544\uBB34\uB3C4 \uC874\uC7AC\uD558\uC9C0 \uC54A\uC2B5\uB2C8\uB2E4! \uADF8\uB97C
    \uB9D0\uB9AC\uC9C0 \uC54A\uB294\uB2E4\uBA74 \uAD50\uB2E8\uC5D0 \uBB34\uC2A8 \uC77C\uC774
    \uC77C\uC5B4\uB0A0 \uC9C0 \uBAA8\uB985\uB2C8\uB2E4. \uADFC\uB370 \uC740\uD1F4\uB9CC
    \uD558\uBA74 \uC54C \uBC14 \uC544\uB2C8\uC9C0 \uC54A\uB098?"
  - "\uD3C9\uC0DD \uBD09\uC0AC\uC758 \uC0B6\uC744 \uC0B4\uC544\uC628 \uADF8\uB294
    \uC0AC\uB78C\uB4E4\uC5D0\uAC8C \uC131\uC790\uB85C \uBD88\uB9BD\uB2C8\uB2E4. \uC2E0\uB3C4\uB4E4\uC758
    \uACE0\uCDA9\uC744 \uB204\uAD6C\uBCF4\uB2E4 \uC798 \uC54C\uACE0 \uC788\uB294
    \uADF8\uB294, \uC5B8\uC820\uAC00 \uAD50\uB2E8\uC744 \uAC1C\uD601\uD560 \uAC83\uC744
    \uAFC8\uAFB8\uACE0 \uC788\uC2B5\uB2C8\uB2E4."
  - "\uC218\uC2ED \uB144\uAC04 \uD0DC\uC591\uC758 \uD798\uC744 \uC5BB\uAE30 \uC704\uD574
    \uC218\uB828\uD574 \uC628 \uBCA0\uD14C\uB791 \uC218\uB3C4\uC790\uC785\uB2C8\uB2E4.
    \uACF0\uC774\uB77C\uACE0 \uC595\uBCF4\uC9C0 \uB9C8\uC138\uC694! \uC120\uB7C9\uD574
    \uBCF4\uC774\uB294 \uADF8\uC758 \uC5BC\uAD74 \uB4A4\uC5D0\uB294 \uC5B4\uB5A4
    \uC74C\uBAA8\uAC00 \uB3C4\uC0AC\uB9AC\uACE0 \uC788\uC744\uC9C0 \uBAA8\uB985\uB2C8\uB2E4!"
  DummyPassives:
  - 
  - "\uD328\uC2DC\uBE0C : \uC5F0\uC124 \uC131\uACF5 \uD655\uB960 <color=blue>90%</color>\\n1\uB4F1
    \uC2DC : \uBAA8\uB4E0 \uD6C4\uBCF4\uC758 \uC5F0\uC124 \uC131\uACF5 \uD655\uB960
    <color=blue>10%</color> \uAC10\uC18C"
  - "\uD328\uC2DC\uBE0C : \uAD50\uC8FC \uC120\uCD9C \uD655\uB960 <color=green>2%</color>
    \uAC10\uC18C\\n1\uB4F1 \uC2DC : \uD50C\uB808\uC774\uC5B4 \uACF5\uC791\uC5D0 \uD544\uC694\uD55C
    \uC815\uCE58\uB825 <color=blue>1</color> \uC99D\uAC00"
  - "\uD328\uC2DC\uBE0C : \uCD5C\uB300 \uCCB4\uB825 <color=red>15</color>\\n1\uB4F1
    \uC2DC : \uBAA8\uB4E0 \uD50C\uB808\uC5B4\uC5B4\uAC00 \uD134\uB9C8\uB2E4 30% \uD655\uB960\uB85C
    \uCCB4\uB825 <color=red>1</color> \uAC10\uC18C"
