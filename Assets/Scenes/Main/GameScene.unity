  - {fileID: -4298056599330406823, guid: 1be96d7679941ec40a6dced40c2fa12c, type: 3}
  - {fileID: 7160429211405778527, guid: c64919900c0deac47abbff4161e7e9b3, type: 3}
  - {fileID: 7403223971960631688, guid: a0c61759b82988b44b25b5fed8483aa5, type: 3}
  - {fileID: 2541578484247144546, guid: 5f572be13928b3d4b9b5bc0829f8e8bc, type: 3}
  - {fileID: 5539459383266630811, guid: 656a2e33b7fcc9d4d9bc7e2ef2afc70f, type: 3}
  - {fileID: 1999468315446188492, guid: c6491e11e744a6f46aa30fe0e10b78a2, type: 3}
  - {fileID: 8367095577647549825, guid: b9d144e86887f7940aa8bd6cd66786e6, type: 3}
  - {fileID: -3947437934144596530, guid: 7547a5c94d1f85141a0edb00f745b51a, type: 3}
  anim: {fileID: 964209054}
  animState: 0
  ElectionMessage: "\uC6B4\uBA85\uC758 \uC21C\uAC04\uC774\uB2E4...\\n\uC81C\uBC1C
    \uB098\uB9CC \uC544\uB2C8\uBA74 \uB3FC."
  ElectionSubMessage: "\uD22C\uD45C\uD568\uC744 \uB20C\uB7EC \uD22C\uD45C \uACB0\uACFC\uB97C
    \uD655\uC778\uD558\uC138\uC694!"
  JudgeMessage:
  - "NAME\uC774\uC5EC, \uADC0\uCC2E\uC544\uB3C4 \uD0DC\uC591\uC758 \uC2E0\uD0C1\uC744
    \uBC1B\uC544\uB4E4\uC5EC\uB77C."
  - "\uAC15\uACBD\uD30C\uC758 \uC218\uC7A5\uC778 NAME\uC740 \uACB0\uC5F0\uD55C \uC790\uC138\uB85C
    \uC2E0\uD0C1\uC744 \uB9DE\uB294\uB2E4.\\n\uC81C\uBC1C \uC774\uBC88\uC5D0 \uC131\uACF5\uD574\uC11C
    \uB098\uB294 \uC740\uD1F4\uD558\uC790."
  - "\uC9C4\uBCF4\uD30C\uC758 \uC218\uC7A5\uC778 NAME\uC740 \uCD08\uC5F0\uD558\uAC8C
    \uC2E0\uD0C1\uC744 \uC900\uBE44\uD55C\uB2E4.\\n\uC81C\uBC1C \uC774\uBC88\uC5D0
    \uB2F9\uC120\uD574\uC11C \uB098\uB294 \uC740\uD1F4\uD558\uC790."
  - "\uAD50\uB2E8 \uBCF4\uC218\uD30C\uC758 \uC218\uC7A5\uC778 NAME\uC740 \uD478\uADFC\uD55C
    \uBBF8\uC18C\uB97C \uB744\uBA70 \uC2E0\uD0C1\uC744 \uB9DE\uB294\uB2E4.\\n\uC81C\uBC1C
    \uC774\uBC88\uC5D0 \uB2F9\uC120\uD574\uC11C \uB098\uB294 \uC740\uD1F4\uD558\uC790."
